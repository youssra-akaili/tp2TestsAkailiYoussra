<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Sortie des logs dans la console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Niveau DEBUG pour LangChain4j : affiche les requêtes et réponses du LLM (test 7) -->
    <logger name="dev.langchain4j" level="DEBUG"/>

    <!-- Pour ne plus voir le long avertissement sur la gestion des erreurs des outils -->
    <logger name="dev.langchain4j.service.ToolErrorHandlingNotice" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>